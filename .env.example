# Copia este archivo como .env y ajusta los valores antes de ejecutar docker compose up.

# --- Base de datos ---
POSTGRES_USER=inventario
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=inventario

# --- API ---
# Minimo 32 caracteres. Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173
LOW_STOCK_THRESHOLD=10
TZ_NAME=America/Bogota

# --- Usuario de prueba (datos semilla) ---
SEED_ADMIN_EMAIL=admin@vise.com
SEED_ADMIN_PASSWORD=Admin123*

# --- Parte 2: RPA de antecedentes (todos opcionales) ---
ANTECEDENTES_TIMEOUT=5
ANTECEDENTES_RETRIES=3
RPA_WORKERS=1
# Solo en Linux: para que el RPA pueda escribir el reporte en parte2-rpa/data/salida, descomente
# y ponga el resultado de `id -u` y `id -g`. En Windows y macOS (Docker Desktop) déjelos así.
# RPA_UID=1000
# RPA_GID=1000

# --- Puertos publicados en el equipo ---
FRONTEND_PORT=5173
BACKEND_PORT=3000
ANTECEDENTES_MOCK_PORT=8080
