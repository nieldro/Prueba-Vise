generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MovementType {
  ENTRADA
  SALIDA

  @@map("movement_type")
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  name         String
  passwordHash String     @map("password_hash")
  createdAt    DateTime   @default(now()) @map("created_at")
  movements    Movement[]

  @@map("users")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  products  Product[]

  @@map("categories")
}

model Product {
  id         Int        @id @default(autoincrement())
  name       String
  sku        String     @unique
  categoryId Int        @map("category_id")
  price      Decimal    @db.Decimal(12, 2)
  brand      String?
  description String?
  /// Unidad de medida del inventario (Und, Caja, Par...).
  unit       String     @default("Und")
  /// Rutas de las imagenes del producto (la primera es la principal).
  images     String[]   @default([])
  /// Especificaciones tecnicas como lista de { label, value }.
  specs      Json?
  /// Solo se modifica a traves de movimientos (ver MovementsService).
  stock      Int        @default(0)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  movements  Movement[]

  @@index([categoryId])
  @@index([stock])
  @@map("products")
}

model Movement {
  id           Int          @id @default(autoincrement())
  productId    Int          @map("product_id")
  type         MovementType
  quantity     Int
  /// Saldo del producto inmediatamente despues de aplicar este movimiento.
  balanceAfter Int          @map("balance_after")
  note         String?
  userId       Int?         @map("user_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([createdAt])
  @@map("movements")
}
